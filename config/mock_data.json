  "tool_contract": {
    "lookup_order": "lookup_order(order_id) -> {status, delivery_date, eta, items[], customer_email, is_gift, membership} | {error:'NOT_FOUND'}",
    "lookup_orders_by_email": "lookup_orders_by_email(email) -> [order_id...] (dùng khi khách quên mã đơn)",
    "check_return_eligibility": "check_return_eligibility(order_id, item_id) -> {eligible: bool, reason_code, refund_method, days_left}",
    "check_inventory": "check_inventory(product, size, color) -> {stock: int} (bắt buộc gọi trước khi đổi size/màu)",
    "initiate_return": "initiate_return(order_id, item_id, reason, refund_method) -> {ticket_id, status}",
    "initiate_exchange": "initiate_exchange(order_id, item_id, new_size, new_color) -> {ticket_id, status}",
    "get_return_policy": "get_return_policy(category?) -> nội dung chính sách"
  },

